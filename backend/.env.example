# ─────────────────────────────────────────────────────────────
#  HelpDesk Pro – Backend Environment Variables Template
#  1. Copy this file: cp .env.example .env
#  2. Fill in ALL required values below.
#  3. NEVER commit .env to version control (.gitignore excludes it).
#
#  IMPORTANT: Spring Boot does NOT auto-load .env files.
#  You must export these variables into your shell, or use the
#  spring-dotenv library (dev only), or configure your IDE run profile.
#
#  Linux/macOS: export $(cat .env | xargs)
#  PowerShell:  Get-Content .env | ForEach-Object { $k,$v = $_ -split '=',2; Set-Item "env:$k" $v }
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/helpdesk_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=your_mysql_user
DB_PASSWORD=your_mysql_password

# ── JWT ───────────────────────────────────────────────────────
# REQUIRED: generate with:  openssl rand -base64 64
# Must be >= 64 bytes (512 bits) for HS512.
JWT_SECRET=REPLACE_WITH_OUTPUT_OF___openssl_rand_-base64_64

# Access token lifetime: 900000 = 15 minutes (recommended)
JWT_EXPIRATION_MS=900000

# Refresh token lifetime: 604800000 = 7 days
JWT_REFRESH_EXPIRATION_MS=604800000

# ── Server ────────────────────────────────────────────────────
SERVER_PORT=8080

# ── CORS ──────────────────────────────────────────────────────
# Must be the exact frontend origin (no trailing slash).
# Wildcard (*) is NOT allowed when credentials=true.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Agent Bootstrap (seed profile only) ───────────────────────
# Only used when: mvn spring-boot:run -Dspring-boot.run.profiles=seed
# Leave blank to disable the seed runner.
AGENT_BOOTSTRAP_SECRET=
AGENT_EMAIL=agent@helpdesk.local
AGENT_PASSWORD=

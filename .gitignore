# ─────────────────────────────────────────────────────────────
#  Git ignore – HelpDesk Pro root
# ─────────────────────────────────────────────────────────────

# ── Secrets (NEVER commit) ────────────────────────────────────
.env
*.env.local
*.env.production

# ── Backend – Maven / Java ────────────────────────────────────
backend/target/
backend/.mvn/
backend/*.class
backend/.classpath
backend/.project
backend/.settings/
backend/.idea/
backend/*.iml
backend/.factorypath

# ── Frontend – Node ───────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────
.idea/
*.iml
*.iws
.vscode/
*.swp
*.swo
